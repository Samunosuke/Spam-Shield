{
  "manifest_version": 3,
  "name": "Suke.EmailValidationAddon",
  "version": "1.2",
  "description": "Validiert Absender-Domänen per DNS/SPF/DKIM, um Spam zu erkennen – inkl. Ordnerprüfung, Score-Konfiguration und Live-Diagnose.",
  "browser_specific_settings": {
    "gecko": {
      "id": "email-validation@suke.local",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "messagesRead",
    "accountsRead",
    "messagesMove",
    "messagesUpdate",
    "menus",
    "storage"
  ],
  "host_permissions": [
    "https://cloudflare-dns.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Suke Email Validation – Live-Diagnose & Ordnerprüfung",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}