{
  "manifest_version": 3,
  "name": "Spam Shield",
  "version": "1.8",
  "description": "Validates sender domains via whitelist/blacklist, DNS, SPF, DKIM, DMARC, domain age (RDAP), DNSBL and spam-kit detection (EN/DE).",
  "browser_specific_settings": {
    "gecko": {
      "id": "spam-shield@addon.mozilla.org",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "messagesRead",
    "accountsRead",
    "messagesMove",
    "messagesUpdate",
    "messagesTags",
    "menus",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://cloudflare-dns.com/*",
    "https://data.iana.org/*"
  ],
  "background": {
    "scripts": [
      "i18n.js",
      "background.js"
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_label": "",
    "default_title": "Spam Shield – Live-Diagnose & Ordnerprüfung",
    "default_popup": "popup.html"
  },
  "message_display_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_label": "Spam Shield",
    "default_title": "Spam Shield – Bewertung & Diagnose",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}