{
  "manifest_version": 3,
  "name": "Suke.EmailValidationAddon",
  "version": "1.6",
  "description": "Validiert Absender-Domänen per Whitelist/Blacklist, DNS, SPF, DKIM, DMARC, Domain-Alter (RDAP), DNSBL und Spam-Baukasten-Erkennung (DE/EN).",
  "browser_specific_settings": {
    "gecko": {
      "id": "email-validation@suke.local",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "messagesRead",
    "accountsRead",
    "messagesMove",
    "messagesUpdate",
    "menus",
    "storage"
  ],
  "host_permissions": [
    "https://cloudflare-dns.com/*",
    "https://data.iana.org/*"
  ],
  "background": {
    "scripts": [
      "i18n.js",
      "background.js"
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_label": "",
    "default_title": "Suke Email Validation – Live-Diagnose & Ordnerprüfung",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}