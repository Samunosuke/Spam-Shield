{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.8.1",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "spam-shield@addon.mozilla.org",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "messagesRead",
    "accountsRead",
    "messagesMove",
    "messagesUpdate",
    "messagesTags",
    "messagesTagsList",
    "menus",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://cloudflare-dns.com/*",
    "https://data.iana.org/*"
  ],
  "background": {
    "scripts": [
      "i18n.js",
      "background.js"
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_label": "",
    "default_title": "__MSG_actionDefaultTitle__",
    "default_popup": "popup.html"
  },
  "message_display_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_label": "__MSG_extensionName__",
    "default_title": "__MSG_messageDisplayActionTitle__",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}